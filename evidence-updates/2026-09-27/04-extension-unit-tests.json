  "tests": [
    {
      "id": "B01",
      "name": "Pause blocks a fresh command",
      "observation": {
        "command_executed": false,
        "result": "paused"
      }
    },
    {
      "id": "B02",
      "name": "Pause does not suppress browser event metadata",
      "observation": {
        "paused": true,
        "frames_at_mock_socket": [
          {
            "type": "event",
            "event": "browser.tab_activated",
            "payload": {
              "tab_id": 7,
              "window_id": 1,
              "url": "https://example.com/private?marker=SYNTHETIC",
              "title": "SYNTHETIC_TITLE"
            },
            "ts_ms": 1801000000000
          },
          {
            "type": "event",
            "event": "browser.page_loaded",
            "payload": {
              "tab_id": 7,
              "url": "https://example.com/private?marker=SYNTHETIC",
              "title": "SYNTHETIC_TITLE"
            },
            "ts_ms": 1801000000000
          },
          {
            "type": "event",
            "event": "browser.url_changed",
            "payload": {
              "tab_id": 7,
              "url": "https://example.com/private?marker=SYNTHETIC"
            },
            "ts_ms": 1801000000000
          },
          {
            "type": "event",
            "event": "browser.download_complete",
            "payload": {
              "id": 9,
              "filename": "/synthetic/SYNTHETIC_FILE.pdf",
              "url": "https://example.com/download",
              "finalUrl": "https://example.com/download"
            },
            "ts_ms": 1801000000000
          }
        ]
      }
    },
    {
      "id": "B03",
      "name": "Blocked-site metadata is suppressed",
      "observation": {
        "inputs": [
          "https://hatch.meta.ai/private",
          "https://a.internalfb.com/private",
          "https://web.whatsapp.com/",
          "file:///synthetic/private",
          "http://localhost:9222/json"
        ],
        "frames_at_mock_socket": 0
      }
    },
    {
      "id": "B04",
      "name": "Pause is not restored after worker reconstruction",
      "observation": {
        "persisted_cached_pause_before_restart": true,
        "new_connection_paused": false,
        "synthetic_command_executed": true
      }
    },
    {
      "id": "B05",
      "name": "Unpair clears credentials but retains last command parameters",
      "observation": {
        "credential_removed": true,
