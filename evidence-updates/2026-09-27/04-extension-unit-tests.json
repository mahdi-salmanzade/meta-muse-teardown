          },
          "timestamp": 1801000000000
        }
      }
    },
    {
      "id": "B06",
      "name": "Unpaired browser events do not leave the connection",
      "observation": {
        "frames_after_unpair": 0
      }
    },
    {
      "id": "B07",
      "name": "Expired credentials are loaded and passed to socket construction",
      "observation": {
        "expired_timestamp": 1,
