{
  "manifest_version": 3,
  "name": "Muse Browser Node",
  "version": "1.0.8",
  "key": "",
  "description": "Connects your browser to Muse as a controllable node",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "history",
    "bookmarks",
    "notifications",
    "storage",
    "debugger",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hatch.meta.ai/*",
        "https://agent.meta.ai/*"
      ],
      "js": [
        "lib/pairing-security.js",
        "hatch-web-pairing.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "ids": [
      "*"
    ]
  }
}
